{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project Write",
  "version": "0.1.0",
  "identifier": "app.projectwrite.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Project Write",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "center": true,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' pwmedia: http://pwmedia.localhost",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost pwmedia: http://pwmedia.localhost",
        "worker-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "freezePrototype": true,
      "assetProtocol": {
        "enable": false
      },
      "capabilities": ["main-window"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage"],
    "publisher": "The Project Write authors",
    "copyright": "Copyright (c) 2026 The Project Write authors",
    "license": "MIT OR Apache-2.0",
    "licenseFile": "installer/license.txt",
    "category": "Productivity",
    "shortDescription": "Local writing and knowledge management",
    "longDescription": "Project Write is a local, offline writing and knowledge management app. Documents, media and the knowledge network stay in a library folder on your own disk; nothing is sent over the network.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "dictionaries/": "dictionaries/",
      "../LICENSE-MIT": "LICENSE-MIT",
      "../LICENSE-APACHE": "LICENSE-APACHE",
      "../THIRD-PARTY-LICENSES": "THIRD-PARTY-LICENSES"
    },
    "fileAssociations": [
      {
        "ext": ["pwrite"],
        "name": "Project Write",
        "description": "Project Write document",
        "role": "Editor",
        "mimeType": "application/x-project-write"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "German"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/project-write.desktop",
        "files": {
          "/usr/share/mime/packages/app.projectwrite.desktop.xml": "linux/project-write-mime.xml",
          "/usr/share/doc/project-write/copyright": "installer/license.txt"
        }
      },
      "rpm": {
        "desktopTemplate": "linux/project-write.desktop",
        "files": {
          "/usr/share/mime/packages/app.projectwrite.desktop.xml": "linux/project-write-mime.xml"
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
