{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "The only window. Grants exactly the app's own commands; no fs, shell, sql, path or other plugin permissions (section 20).",
  "windows": ["main"],
  "permissions": [
    "allow-system-check",
    "allow-library-status",
    "allow-library-default-location",
    "allow-library-choose-location",
    "allow-library-create",
    "allow-library-open",
    "allow-library-reopen",
    "allow-library-move",
    "allow-library-cancel-move",
    "allow-library-accept-location",
    "allow-ui-state",
    "allow-ui-update-settings",
    "allow-ui-subscribe",
    "allow-ui-menu-state",
    "allow-ui-set-focus-mode",
    "allow-ui-close-response",
    "allow-documents-list",
    "allow-document-create",
    "allow-document-read",
    "allow-document-save",
    "allow-document-rename",
    "allow-document-import",
    "allow-document-copy",
    "allow-document-set-favorite",
    "allow-document-convert",
    "allow-document-backlinks",
    "allow-external-open",
    "allow-external-read",
    "allow-external-check",
    "allow-external-keep-mine",
    "allow-external-save",
    "allow-external-save-as",
    "allow-external-close",
    "allow-external-import",
    "allow-external-recent",
    "allow-external-open-recent",
    "allow-external-forget-recent",
    "allow-open-requests-take",
    "allow-theme-import",
    "allow-theme-remove",
    "allow-link-open"
  ]
}
