{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "The only window. Grants exactly the app's own commands; no fs, shell, sql, path or other plugin permissions (section 20).",
  "windows": ["main"],
  "permissions": [
    "allow-system-check",
    "allow-library-status",
    "allow-library-default-location",
    "allow-library-choose-location",
    "allow-library-create",
    "allow-library-open",
    "allow-library-reopen",
    "allow-library-move",
    "allow-library-cancel-move",
    "allow-library-accept-location",
    "allow-library-preferences",
    "allow-library-update-preferences",
    "allow-ui-state",
    "allow-ui-update-settings",
    "allow-ui-subscribe",
    "allow-ui-menu-state",
    "allow-ui-set-focus-mode",
    "allow-ui-close-response",
    "allow-documents-list",
    "allow-document-create",
    "allow-document-read",
    "allow-document-save",
    "allow-document-rename",
    "allow-document-import",
    "allow-document-copy",
    "allow-document-set-favorite",
    "allow-document-convert",
    "allow-document-backlinks",
    "allow-document-delete",
    "allow-document-restore",
    "allow-document-archive",
    "allow-documents-trash",
    "allow-document-purge",
    "allow-trash-empty",
    "allow-document-versions",
    "allow-document-version-text",
    "allow-document-version-save",
    "allow-document-version-close",
    "allow-document-version-restore",
    "allow-recovery-write",
    "allow-recovery-discard",
    "allow-recovery-list",
    "allow-recovery-restore",
    "allow-recovery-drop",
    "allow-session-save",
    "allow-session-restore",
    "allow-structure-state",
    "allow-structure-document",
    "allow-subnet-create",
    "allow-subnet-update",
    "allow-subnet-move",
    "allow-subnet-delete",
    "allow-document-assign",
    "allow-document-unassign",
    "allow-document-set-primary",
    "allow-document-move",
    "allow-tag-create",
    "allow-tag-rename",
    "allow-tag-merge",
    "allow-tag-delete",
    "allow-document-tag",
    "allow-document-untag",
    "allow-structure-undo",
    "allow-structure-redo",
    "allow-external-open",
    "allow-external-read",
    "allow-external-check",
    "allow-external-keep-mine",
    "allow-external-save",
    "allow-external-save-as",
    "allow-external-close",
    "allow-external-import",
    "allow-external-recent",
    "allow-external-open-recent",
    "allow-external-forget-recent",
    "allow-open-requests-take",
    "allow-theme-import",
    "allow-theme-remove",
    "allow-link-open"
  ]
}
