{
  "name": "project-write",
  "private": true,
  "version": "0.1.0",
  "description": "Project Write – local, cross-platform writing and knowledge management.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "types:generate": "cargo test --manifest-path src-tauri/Cargo.toml --lib export_bindings",
    "build:e2e": "tauri build --debug --no-bundle --features e2e",
    "test:e2e": "wdio run tests/e2e/wdio.conf.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-code": "3.32.2",
    "@tiptap/extension-code-block": "3.32.2",
    "@tiptap/extension-document": "3.32.2",
    "@tiptap/extension-find-and-replace": "3.32.2",
    "@tiptap/extension-hard-break": "3.32.2",
    "@tiptap/extension-heading": "3.32.2",
    "@tiptap/extension-link": "3.32.2",
    "@tiptap/extension-list": "3.32.2",
    "@tiptap/extension-paragraph": "3.32.2",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/markdown": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@wdio/cli": "9.32.0",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/tauri-service": "1.5.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "webdriverio": "9.32.0"
  }
}
