# Normalise line endings so formatting checks behave the same on every OS.
* text=auto eol=lf
*.png binary
*.ico binary
*.icns binary
# Markdown round-trip inputs stay byte for byte, CRLF included.
tests/fixtures/markdown/** -text
# Dictionaries stay byte for byte (checksums in SHA256SUMS).
src-tauri/dictionaries/** -text
